// File name: projects/01/DMux4Way.hdl

/**
 * 4-way demultiplexor:
 * {a, b, c, d} = {in, 0, 0, 0} if sel == 00
 *                {0, in, 0, 0} if sel == 01
 *                {0, 0, in, 0} if sel == 10
 *                {0, 0, 0, in} if sel == 11
 */

CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    // 利用最高位元 sel[1] 先分為兩路
DMux(in=in, sel=sel[1], a=outAB, b=outCD);
// 利用最低位元 sel[0] 決定最終四路
DMux(in=outAB, sel=sel[0], a=a, b=b);
DMux(in=outCD, sel=sel[0], a=c, b=d);
}