// File name: projects/01/Not.hdl

/**
 * Not gate:
 * out = not in
 */

CHIP Not {
    IN in;
    OUT out;

    PARTS:
    // 將 Nand 的兩個輸入端綁定在一起，就會反轉訊號
    Nand(a=in, b=in, out=out);
}